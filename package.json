{
	"name": "obsidian-canvas-sync",
	"version": "1.0.0",
	"description": "Sync Obsidian markdown files to Canvas LMS",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [
		"obsidian",
		"canvas",
		"lms",
		"sync"
	],
	"author": "Daniel Dehaan",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^18.19.0",
		"@vitest/coverage-v8": "^1.2.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.3.3",
		"vitest": "^1.2.0"
	},
	"dependencies": {
		"marked": "^12.0.0"
	}
}
